# Copia este archivo a .env y llena los valores reales — nunca subas .env con
# credenciales reales al repositorio (sección 49 del brief). En producción,
# estas mismas claves viven en n8n Credentials y en las variables de entorno
# de Supabase, no en un archivo dentro del repo.

# --- Base de datos (Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Datos de mercado (proveedor primario — ver docs/01-diseno-tecnico.md sección 2) ---
TWELVE_DATA_API_KEY=

# --- Proveedor complementario opcional (Fase 3 del diseño técnico) ---
FMP_API_KEY=

# --- Claude API ---
ANTHROPIC_API_KEY=

# --- WhatsApp (Meta Cloud API directo — ver docs/01-diseno-tecnico.md sección 8/10) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_RECIPIENT_NUMBER=

# --- n8n Cloud ---
N8N_WEBHOOK_BASE_URL=
